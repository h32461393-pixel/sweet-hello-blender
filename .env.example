# Public browser configuration (safe to expose)
VITE_SUPABASE_URL=https://YOUR-BACKEND-PROJECT.example
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server configuration (never expose or prefix with VITE_)
SUPABASE_URL=https://YOUR-BACKEND-PROJECT.example
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVER_KEY

# Telegram configuration (server-only secrets)
TELEGRAM_BOT_TOKEN=YOUR_NEW_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET